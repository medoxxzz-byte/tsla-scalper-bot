//@version=5
indicator("TM Reversal Experiments V18 — 1m research windows", overlay=true, max_labels_count=30)

// ─────────────────────────────────────────────────────────────────────────────
// V18 is deliberately separate from TM Reversal Map V17.
// Use it on TSLA / 1-minute chart / Extended Hours enabled.
// It has three limited experiments:
// 1) 10:05–10:35 ET: one map + at most one 1m support/resistance confirmation.
// 2) 10:35–11:05 ET: a separate map + at most one independent confirmation.
// 3) 15:30–15:55 ET: at most one close-breakout research alert.
// Neither experiment changes the V17 5-minute map or GEX messages.
// ─────────────────────────────────────────────────────────────────────────────

// ── Inputs ────────────────────────────────────────────────────────────────────
tz                = input.string("America/New_York", "Market Timezone")
showExperimentMap = input.bool(true, "Show Experiment Zones")
minuteBaseWidth   = input.float(0.08, "1m Base Zone Half-Width ($)", minval=0.03, step=0.01)
minuteMaxWidth    = input.float(0.30, "1m Max Zone Half-Width ($)", minval=0.08, step=0.01)
minuteAtrFactor   = input.float(0.12, "1m ATR Width Multiplier", minval=0.01, step=0.01)
cmfLen            = input.int(20, "CMF Length", minval=5)
obvLen            = input.int(30, "OBV Average Length", minval=5)
momLen            = input.int(12, "Momentum Length", minval=2)
pivotLen          = input.int(3, "1m Pivot Strength", minval=2, maxval=6)
trendAdxMin       = input.float(20.0, "Trend ADX Minimum", minval=10.0, step=1.0)
trendHistFactor   = input.float(1.20, "MACD Histogram Strength vs Average", minval=1.00, step=0.05)

// ── Current 1-minute indicators ──────────────────────────────────────────────
vwapValue = ta.vwap(hlc3)
[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)
momValue = close - close[momLen]
obvValue = ta.cum(math.sign(ta.change(close)) * volume)
obvAvg   = ta.sma(obvValue, obvLen)
atrValue = ta.atr(14)
rsiValue = ta.rsi(close, 14)
[diPlus, diMinus, adxValue] = ta.dmi(14, 14)
volAvg   = ta.sma(volume, 20)
relVol   = na(volAvg) or volAvg == 0 ? 1.0 : volume / volAvg
histAbsAvg = ta.sma(math.abs(histLine), 10)

mfMultiplier = high == low ? 0.0 : ((close - low) - (high - close)) / (high - low)
mfVolume     = mfMultiplier * volume
cmfVolumeSum = math.sum(mfVolume, cmfLen)
volumeSum    = math.sum(volume, cmfLen)
cmfValue     = na(volumeSum) or volumeSum == 0 ? 0.0 : cmfVolumeSum / volumeSum

// ── Confirming 5-minute context; it is a veto, not another 1m signal. ────────
f_macd_hist() =>
    [_, _, _hist] = ta.macd(close, 12, 26, 9)
    _hist

fiveClose = request.security(syminfo.tickerid, "5", close, lookahead=barmerge.lookahead_off)
fiveVwap  = request.security(syminfo.tickerid, "5", ta.vwap(hlc3), lookahead=barmerge.lookahead_off)
fiveHist  = request.security(syminfo.tickerid, "5", f_macd_hist(), lookahead=barmerge.lookahead_off)
fiveBull  = fiveClose > fiveVwap and fiveHist >= 0
fiveBear  = fiveClose < fiveVwap and fiveHist <= 0
fiveBias  = fiveBull ? "bull" : fiveBear ? "bear" : "mixed"

// ── Time and daily state ──────────────────────────────────────────────────────
nyHour = hour(time, tz)
nyMin  = minute(time, tz)
newDay = ta.change(time("D")) != 0
isRegular = (nyHour > 9 or (nyHour == 9 and nyMin >= 30)) and nyHour < 16

// The alert is emitted at bar close: 10:04 bar -> 10:05 delivery.
minuteMapAnchor = nyHour == 10 and nyMin == 4
minuteWindow    = nyHour == 10 and nyMin >= 5 and nyMin < 35
trendWindow     = minuteWindow
minuteBMapAnchor = nyHour == 10 and nyMin == 34
minuteBWindow    = (nyHour == 10 and nyMin >= 35) or (nyHour == 11 and nyMin < 5)
rangeBuild      = nyHour == 15 and nyMin >= 15 and nyMin < 30
closeWindow     = nyHour == 15 and nyMin >= 30 and nyMin < 55

// ── Local levels used only by the 10:05–10:35 experiment ──────────────────────
var float open15High = na
var float open15Low = na
var float lastPivotHigh = na
var float lastPivotLow = na
var float expResistance = na
var float expSupport = na
var float expHalfWidth = na
var bool minuteMapSent = false
var bool minuteAlertSent = false
var bool trendAlertSent = false
var float minuteBResistance = na
var float minuteBSupport = na
var float minuteBHalfWidth = na
var int minuteBMapCloseTime = na
var bool minuteBMapSent = false
var bool minuteBAlertSent = false

// ── 15:15–15:30 range used only by the close experiment ───────────────────────
var float closingRangeHigh = na
var float closingRangeLow = na
var bool closingAlertSent = false

// Phase B keeps every V18 parent event separate.  Observations are research
// telemetry only and do not create Telegram messages.
var trackActions = array.new_string()
var trackOpenTimes = array.new_int()
var trackCloseTimes = array.new_int()
var trackPrices = array.new_float()
var trackSupports = array.new_float()
var trackResistances = array.new_float()
var trackWidths = array.new_float()
var trackRangeHighs = array.new_float()
var trackRangeLows = array.new_float()
var trackHighs = array.new_float()
var trackLows = array.new_float()
var trackPost3Sent = array.new_bool()
var trackPost6Sent = array.new_bool()
var trackPost12Sent = array.new_bool()

if newDay
    open15High := na
    open15Low := na
    lastPivotHigh := na
    lastPivotLow := na
    expResistance := na
    expSupport := na
    expHalfWidth := na
    minuteMapSent := false
    minuteAlertSent := false
    trendAlertSent := false
    minuteBResistance := na
    minuteBSupport := na
    minuteBHalfWidth := na
    minuteBMapCloseTime := na
    minuteBMapSent := false
    minuteBAlertSent := false
    closingRangeHigh := na
    closingRangeLow := na
    closingAlertSent := false
    array.clear(trackActions)
    array.clear(trackOpenTimes)
    array.clear(trackCloseTimes)
    array.clear(trackPrices)
    array.clear(trackSupports)
    array.clear(trackResistances)
    array.clear(trackWidths)
    array.clear(trackRangeHighs)
    array.clear(trackRangeLows)
    array.clear(trackHighs)
    array.clear(trackLows)
    array.clear(trackPost3Sent)
    array.clear(trackPost6Sent)
    array.clear(trackPost12Sent)

isOpenFirst15 = nyHour == 9 and nyMin >= 30 and nyMin < 45
if isOpenFirst15
    open15High := na(open15High) ? high : math.max(open15High, high)
    open15Low := na(open15Low) ? low : math.min(open15Low, low)

pivotHigh = ta.pivothigh(high, pivotLen, pivotLen)
pivotLow  = ta.pivotlow(low, pivotLen, pivotLen)
if not na(pivotHigh)
    lastPivotHigh := pivotHigh
if not na(pivotLow)
    lastPivotLow := pivotLow

if rangeBuild
    closingRangeHigh := na(closingRangeHigh) ? high : math.max(closingRangeHigh, high)
    closingRangeLow := na(closingRangeLow) ? low : math.min(closingRangeLow, low)

prevDayHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
prevDayLow  = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_off)

f_nearest_above(_price, _a, _b, _c, _d) =>
    float best = na
    if not na(_a) and _a > _price
        best := _a
    if not na(_b) and _b > _price and (na(best) or _b < best)
        best := _b
    if not na(_c) and _c > _price and (na(best) or _c < best)
        best := _c
    if not na(_d) and _d > _price and (na(best) or _d < best)
        best := _d
    best

f_nearest_below(_price, _a, _b, _c, _d) =>
    float best = na
    if not na(_a) and _a < _price
        best := _a
    if not na(_b) and _b < _price and (na(best) or _b > best)
        best := _b
    if not na(_c) and _c < _price and (na(best) or _c > best)
        best := _c
    if not na(_d) and _d < _price and (na(best) or _d > best)
        best := _d
    best

candidateResistance = f_nearest_above(close, prevDayHigh, open15High, lastPivotHigh, vwapValue)
candidateSupport    = f_nearest_below(close, prevDayLow, open15Low, lastPivotLow, vwapValue)
candidateResistance := na(candidateResistance) ? lastPivotHigh : candidateResistance
candidateSupport := na(candidateSupport) ? lastPivotLow : candidateSupport
minuteWidth = math.min(minuteMaxWidth, math.max(minuteBaseWidth, atrValue * minuteAtrFactor))

// ── Shared payload helpers ────────────────────────────────────────────────────
f_json_num(_value) =>
    na(_value) ? "null" : str.tostring(_value, "#.##")

f_bool(_value) =>
    _value ? "true" : "false"

f_experiment_window(_action) =>
    str.startswith(_action, "MINUTE_B_") ? "B_10_35_11_05" : str.startswith(_action, "MINUTE_") ? "A_10_05_10_35" : str.startswith(_action, "CLOSE_") ? "CLOSING_15_30_15_55" : "unknown"

f_payload(string _action, float _resistance, float _support, float _width, float _rangeHigh, float _rangeLow) =>
    '{"schema_version":"event-v2","symbol":"' + syminfo.ticker + '","timeframe":"1m","bar_open_time":' + str.tostring(time) + ',"bar_close_time":' + str.tostring(time_close) + ',"action":"' + _action + '","experiment_window":"' + f_experiment_window(_action) + '","price":' + f_json_num(close) + ',"vwap":' + f_json_num(vwapValue) + ',"resistance":' + f_json_num(_resistance) + ',"support":' + f_json_num(_support) + ',"zone_half_width":' + f_json_num(_width) + ',"range_high":' + f_json_num(_rangeHigh) + ',"range_low":' + f_json_num(_rangeLow) + ',"cmf":' + f_json_num(cmfValue) + ',"obv_bull":' + f_bool(obvValue > obvAvg) + ',"obv_breakout":' + f_bool(obvValue > ta.highest(obvValue[1], 10) or obvValue < ta.lowest(obvValue[1], 10)) + ',"relative_volume":' + f_json_num(relVol) + ',"hist":' + f_json_num(histLine) + ',"momentum":' + f_json_num(momValue) + ',"rsi":' + f_json_num(rsiValue) + ',"adx":' + f_json_num(adxValue) + ',"bull_score":' + str.tostring((close > vwapValue ? 1 : 0) + (cmfValue > 0 and obvValue > obvAvg and relVol >= 0.85 ? 1 : 0) + (histLine > 0 and momValue > 0 ? 1 : 0)) + ',"bear_score":' + str.tostring((close < vwapValue ? 1 : 0) + (cmfValue < 0 and obvValue < obvAvg and relVol >= 0.85 ? 1 : 0) + (histLine < 0 and momValue < 0 ? 1 : 0)) + ',"five_minute_bias":"' + fiveBias + '"}'

f_startTracking(_action, _resistance, _support, _width, _rangeHigh, _rangeLow) =>
    array.push(trackActions, _action)
    array.push(trackOpenTimes, time)
    array.push(trackCloseTimes, time_close)
    array.push(trackPrices, close)
    array.push(trackSupports, _support)
    array.push(trackResistances, _resistance)
    array.push(trackWidths, _width)
    array.push(trackRangeHighs, _rangeHigh)
    array.push(trackRangeLows, _rangeLow)
    array.push(trackHighs, close)
    array.push(trackLows, close)
    array.push(trackPost3Sent, false)
    array.push(trackPost6Sent, false)
    array.push(trackPost12Sent, false)

f_trackingPayload(_index, _observationType) =>
    _parentAction = array.get(trackActions, _index)
    _parentOpen = array.get(trackOpenTimes, _index)
    _parentClose = array.get(trackCloseTimes, _index)
    _parentSupport = array.get(trackSupports, _index)
    _parentResistance = array.get(trackResistances, _index)
    _parentWidth = array.get(trackWidths, _index)
    _parentRangeHigh = array.get(trackRangeHighs, _index)
    _parentRangeLow = array.get(trackRangeLows, _index)
    _cumulativeHigh = array.get(trackHighs, _index)
    _cumulativeLow = array.get(trackLows, _index)
    '{"tracking_version":"tracking-v1","parent_schema_version":"event-v2","parent_symbol":"' + syminfo.ticker + '","parent_timeframe":"1m","parent_bar_open_time":' + str.tostring(_parentOpen) + ',"parent_bar_close_time":' + str.tostring(_parentClose) + ',"parent_action":"' + _parentAction + '","parent_support":' + f_json_num(_parentSupport) + ',"parent_resistance":' + f_json_num(_parentResistance) + ',"parent_range_low":' + f_json_num(_parentRangeLow) + ',"parent_range_high":' + f_json_num(_parentRangeHigh) + ',"parent_zone_half_width":' + f_json_num(_parentWidth) + ',"observation_type":"' + _observationType + '","observed_bar_open_time":' + str.tostring(time) + ',"observed_bar_close_time":' + str.tostring(time_close) + ',"price_open":' + f_json_num(open) + ',"price_high":' + f_json_num(high) + ',"price_low":' + f_json_num(low) + ',"price_close":' + f_json_num(close) + ',"volume":' + f_json_num(volume) + ',"vwap":' + f_json_num(vwapValue) + ',"cmf":' + f_json_num(cmfValue) + ',"relative_volume":' + f_json_num(relVol) + ',"five_minute_close":' + f_json_num(fiveClose) + ',"five_minute_vwap":' + f_json_num(fiveVwap) + ',"cumulative_high":' + f_json_num(_cumulativeHigh) + ',"cumulative_low":' + f_json_num(_cumulativeLow) + '}'

f_removeTracking(_index) =>
    array.remove(trackActions, _index)
    array.remove(trackOpenTimes, _index)
    array.remove(trackCloseTimes, _index)
    array.remove(trackPrices, _index)
    array.remove(trackSupports, _index)
    array.remove(trackResistances, _index)
    array.remove(trackWidths, _index)
    array.remove(trackRangeHighs, _index)
    array.remove(trackRangeLows, _index)
    array.remove(trackHighs, _index)
    array.remove(trackLows, _index)
    array.remove(trackPost3Sent, _index)
    array.remove(trackPost6Sent, _index)
    array.remove(trackPost12Sent, _index)

f_emitEvent(_action, _resistance, _support, _width, _rangeHigh, _rangeLow) =>
    alert(f_payload(_action, _resistance, _support, _width, _rangeHigh, _rangeLow), alert.freq_once_per_bar_close)
    f_startTracking(_action, _resistance, _support, _width, _rangeHigh, _rangeLow)

// ── Experiment A: one 1-minute map, then at most one confirmation ───────────
if barstate.isconfirmed and minuteMapAnchor and not minuteMapSent
    expResistance := candidateResistance
    expSupport := candidateSupport
    expHalfWidth := minuteWidth
    minuteMapSent := true
    f_emitEvent("MINUTE_MAP", expResistance, expSupport, expHalfWidth, float(na), float(na))

// ── Experiment B: an independent post-opening map and one confirmation ───────
if barstate.isconfirmed and minuteBMapAnchor and not minuteBMapSent
    minuteBResistance := candidateResistance
    minuteBSupport := candidateSupport
    minuteBHalfWidth := minuteWidth
    minuteBMapCloseTime := time_close
    minuteBMapSent := true
    f_emitEvent("MINUTE_B_MAP", minuteBResistance, minuteBSupport, minuteBHalfWidth, float(na), float(na))

touchSupport = minuteMapSent and not na(expSupport) and not na(expHalfWidth) and low <= expSupport + expHalfWidth and high >= expSupport - expHalfWidth
touchResistance = minuteMapSent and not na(expResistance) and not na(expHalfWidth) and high >= expResistance - expHalfWidth and low <= expResistance + expHalfWidth

bullStructure = close > open and close > expSupport
bearStructure = close < open and close < expResistance
bullLiquidity = cmfValue > 0 and obvValue > obvAvg and relVol >= 0.85
bearLiquidity = cmfValue < 0 and obvValue < obvAvg and relVol >= 0.85
bullMomentum  = histLine > 0 and momValue > 0
bearMomentum  = histLine < 0 and momValue < 0
bullScore = (bullStructure ? 1 : 0) + (bullLiquidity ? 1 : 0) + (bullMomentum ? 1 : 0)
bearScore = (bearStructure ? 1 : 0) + (bearLiquidity ? 1 : 0) + (bearMomentum ? 1 : 0)

minuteCallConfirm = minuteWindow and touchSupport and bullScore >= 2 and fiveBull
minutePutConfirm = minuteWindow and touchResistance and bearScore >= 2 and fiveBear

touchMinuteBSupport = minuteBMapSent and not na(minuteBSupport) and not na(minuteBHalfWidth) and low <= minuteBSupport + minuteBHalfWidth and high >= minuteBSupport - minuteBHalfWidth
touchMinuteBResistance = minuteBMapSent and not na(minuteBResistance) and not na(minuteBHalfWidth) and high >= minuteBResistance - minuteBHalfWidth and low <= minuteBResistance + minuteBHalfWidth
minuteBReady = minuteBMapSent and not na(minuteBMapCloseTime) and time_close > minuteBMapCloseTime
minuteBCallConfirm = minuteBWindow and minuteBReady and touchMinuteBSupport and bullScore >= 2 and fiveBull
minuteBPutConfirm = minuteBWindow and minuteBReady and touchMinuteBResistance and bearScore >= 2 and fiveBear

// ── Experiment A.1: one trend-context message; it never means buy at market. ──
macdBullPower = not na(histLine[2]) and histLine > 0 and histLine[1] > 0 and histLine > histLine[1] and histLine[1] > histLine[2] and histLine > histAbsAvg * trendHistFactor and histLine[1] > histAbsAvg[1] * trendHistFactor
macdBearPower = not na(histLine[2]) and histLine < 0 and histLine[1] < 0 and histLine < histLine[1] and histLine[1] < histLine[2] and math.abs(histLine) > histAbsAvg * trendHistFactor and math.abs(histLine[1]) > histAbsAvg[1] * trendHistFactor
obvBreakUp = obvValue > obvAvg and obvValue > ta.highest(obvValue[1], 10)
obvBreakDown = obvValue < obvAvg and obvValue < ta.lowest(obvValue[1], 10)
trendBull = trendWindow and close > vwapValue and macdLine > 0 and macdBullPower and rsiValue > 55 and obvBreakUp and adxValue >= trendAdxMin and fiveBull
trendBear = trendWindow and close < vwapValue and macdLine < 0 and macdBearPower and rsiValue < 45 and obvBreakDown and adxValue >= trendAdxMin and fiveBear

if barstate.isconfirmed and isRegular and not trendAlertSent
    if trendBull
        trendAlertSent := true
        f_emitEvent("MINUTE_TREND_BULL", expResistance, expSupport, expHalfWidth, float(na), float(na))
    else if trendBear
        trendAlertSent := true
        f_emitEvent("MINUTE_TREND_BEAR", expResistance, expSupport, expHalfWidth, float(na), float(na))

if barstate.isconfirmed and isRegular and not minuteAlertSent
    if minuteCallConfirm
        minuteAlertSent := true
        f_emitEvent("MINUTE_CALL_CONFIRM", expResistance, expSupport, expHalfWidth, float(na), float(na))
    else if minutePutConfirm
        minuteAlertSent := true
        f_emitEvent("MINUTE_PUT_CONFIRM", expResistance, expSupport, expHalfWidth, float(na), float(na))

if barstate.isconfirmed and isRegular and not minuteBAlertSent
    if minuteBCallConfirm
        minuteBAlertSent := true
        f_emitEvent("MINUTE_B_CALL_CONFIRM", minuteBResistance, minuteBSupport, minuteBHalfWidth, float(na), float(na))
    else if minuteBPutConfirm
        minuteBAlertSent := true
        f_emitEvent("MINUTE_B_PUT_CONFIRM", minuteBResistance, minuteBSupport, minuteBHalfWidth, float(na), float(na))

// ── Experiment B: one close-breakout research alert; never after 15:55 ET ────
closeBreakout = closeWindow and not na(closingRangeHigh) and close > closingRangeHigh and volume > volAvg and cmfValue > 0 and not fiveBear
closeBreakdown = closeWindow and not na(closingRangeLow) and close < closingRangeLow and volume > volAvg and cmfValue < 0 and not fiveBull

if barstate.isconfirmed and isRegular and not closingAlertSent
    if closeBreakout
        closingAlertSent := true
        f_emitEvent("CLOSE_BREAKOUT_CALL", closingRangeHigh, closingRangeLow, 0.0, closingRangeHigh, closingRangeLow)
    else if closeBreakdown
        closingAlertSent := true
        f_emitEvent("CLOSE_BREAKDOWN_PUT", closingRangeHigh, closingRangeLow, 0.0, closingRangeHigh, closingRangeLow)

// ── Phase B: 3/6/12-minute silent observations after every V18 event ─────────
if barstate.isconfirmed and array.size(trackActions) > 0
    for index = array.size(trackActions) - 1 to 0
        cumulativeHigh = math.max(array.get(trackHighs, index), high)
        cumulativeLow = math.min(array.get(trackLows, index), low)
        array.set(trackHighs, index, cumulativeHigh)
        array.set(trackLows, index, cumulativeLow)
        elapsedMs = time_close - array.get(trackCloseTimes, index)
        closingParent = str.startswith(array.get(trackActions, index), "CLOSE_")
        atRegularSessionClose = nyHour == 15 and nyMin == 59
        finalDueAt = array.get(trackCloseTimes, index) + 12 * 60 * 1000
        needsSessionCensor = time_close <= finalDueAt
        if closingParent and atRegularSessionClose and needsSessionCensor
            alert(f_trackingPayload(index, "close_1600"), alert.freq_all)
            f_removeTracking(index)
        else if closingParent and atRegularSessionClose
            // A completed horizon should already have been removed.  Do not
            // emit a late observation into after-hours if it was not.
            f_removeTracking(index)
        else if elapsedMs == 3 * 60 * 1000 and not array.get(trackPost3Sent, index)
            array.set(trackPost3Sent, index, true)
            alert(f_trackingPayload(index, "post_3m"), alert.freq_all)
        else if elapsedMs == 6 * 60 * 1000 and not array.get(trackPost6Sent, index)
            array.set(trackPost6Sent, index, true)
            alert(f_trackingPayload(index, "post_6m"), alert.freq_all)
        else if elapsedMs == 12 * 60 * 1000 and not array.get(trackPost12Sent, index)
            array.set(trackPost12Sent, index, true)
            alert(f_trackingPayload(index, "post_12m"), alert.freq_all)
            f_removeTracking(index)

// ── Visuals: only the temporary 1m experiment zones ───────────────────────────
resTop = expResistance + expHalfWidth
resBottom = expResistance - expHalfWidth
supTop = expSupport + expHalfWidth
supBottom = expSupport - expHalfWidth

pResTop = plot(showExperimentMap and minuteMapSent ? resTop : na, "1m Experiment Resistance Top", color=color.new(color.red, 30), linewidth=1, style=plot.style_linebr)
pResBottom = plot(showExperimentMap and minuteMapSent ? resBottom : na, "1m Experiment Resistance Bottom", color=color.new(color.red, 30), linewidth=1, style=plot.style_linebr)
pSupTop = plot(showExperimentMap and minuteMapSent ? supTop : na, "1m Experiment Support Top", color=color.new(color.lime, 30), linewidth=1, style=plot.style_linebr)
pSupBottom = plot(showExperimentMap and minuteMapSent ? supBottom : na, "1m Experiment Support Bottom", color=color.new(color.lime, 30), linewidth=1, style=plot.style_linebr)
fill(pResTop, pResBottom, color=color.new(color.red, 92), title="1m Experiment Resistance Area")
fill(pSupTop, pSupBottom, color=color.new(color.lime, 92), title="1m Experiment Support Area")
bResTop = minuteBResistance + minuteBHalfWidth
bResBottom = minuteBResistance - minuteBHalfWidth
bSupTop = minuteBSupport + minuteBHalfWidth
bSupBottom = minuteBSupport - minuteBHalfWidth
pBResTop = plot(showExperimentMap and minuteBMapSent ? bResTop : na, "1m B Resistance Top", color=color.new(color.orange, 25), linewidth=1, style=plot.style_linebr)
pBResBottom = plot(showExperimentMap and minuteBMapSent ? bResBottom : na, "1m B Resistance Bottom", color=color.new(color.orange, 25), linewidth=1, style=plot.style_linebr)
pBSupTop = plot(showExperimentMap and minuteBMapSent ? bSupTop : na, "1m B Support Top", color=color.new(color.aqua, 25), linewidth=1, style=plot.style_linebr)
pBSupBottom = plot(showExperimentMap and minuteBMapSent ? bSupBottom : na, "1m B Support Bottom", color=color.new(color.aqua, 25), linewidth=1, style=plot.style_linebr)
fill(pBResTop, pBResBottom, color=color.new(color.orange, 92), title="1m B Resistance Area")
fill(pBSupTop, pBSupBottom, color=color.new(color.aqua, 92), title="1m B Support Area")
plot(showExperimentMap ? vwapValue : na, "1m VWAP", color=color.orange, linewidth=1)

plotshape(showExperimentMap and trendBull and not trendAlertSent[1], title="1m Bull Trend Context", style=shape.labelup, location=location.belowbar, color=color.green, size=size.tiny, text="TREND")
plotshape(showExperimentMap and trendBear and not trendAlertSent[1], title="1m Bear Trend Context", style=shape.labeldown, location=location.abovebar, color=color.maroon, size=size.tiny, text="TREND")
plotshape(showExperimentMap and minuteCallConfirm and not minuteAlertSent[1], title="1m CALL Experiment", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny, text="1m")
plotshape(showExperimentMap and minutePutConfirm and not minuteAlertSent[1], title="1m PUT Experiment", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny, text="1m")
plotshape(showExperimentMap and minuteBCallConfirm and not minuteBAlertSent[1], title="1m B CALL Experiment", style=shape.triangleup, location=location.belowbar, color=color.aqua, size=size.tiny, text="B")
plotshape(showExperimentMap and minuteBPutConfirm and not minuteBAlertSent[1], title="1m B PUT Experiment", style=shape.triangledown, location=location.abovebar, color=color.orange, size=size.tiny, text="B")
plotshape(showExperimentMap and closeBreakout and not closingAlertSent[1], title="Close Breakout Research", style=shape.labelup, location=location.belowbar, color=color.green, size=size.tiny, text="CLOSE")
plotshape(showExperimentMap and closeBreakdown and not closingAlertSent[1], title="Close Breakdown Research", style=shape.labeldown, location=location.abovebar, color=color.maroon, size=size.tiny, text="CLOSE")

var label statusLabel = na
if barstate.islast and showExperimentMap
    label.delete(statusLabel)
    statusText = "TM V18 Experiments | 1m\nA: 10:05–10:35 map + one trend context + one confirmation\nB: 10:35–11:05 independent map + one confirmation\n15:30–15:55 one close observation\nResearch only — no chase"
    statusLabel := label.new(bar_index, high, statusText, style=label.style_label_down, textcolor=color.white, color=color.new(color.black, 25), size=size.tiny)
