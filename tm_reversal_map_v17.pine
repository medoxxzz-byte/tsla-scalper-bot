//@version=5
indicator("TM Reversal Map V17 — مناطق وقرار هادئ", overlay=true, max_labels_count=100)

// ─────────────────────────────────────────────────────────────────────────────
// TM Reversal Map V17
// يعمل على TSLA / فريم 5 دقائق / مع تفعيل Extended Hours في الشارت.
// يرسل خرائط في 09:25، 09:45، 10:15، 11:00 ET عند إغلاق الشمعة السابقة.
// بعد 11:00: تنبيه واحد فقط عند منطقة خريطة + إغلاق 5 دقائق حاسم.
// ─────────────────────────────────────────────────────────────────────────────

// ── Inputs ────────────────────────────────────────────────────────────────────
tz               = input.string("America/New_York", "Market Timezone")
baseHalfWidth    = input.float(0.15, "Base Zone Half-Width ($)", minval=0.01, step=0.01)
maxHalfWidth     = input.float(0.60, "Max Zone Half-Width ($)", minval=0.15, step=0.05)
atrWidthFactor   = input.float(0.12, "ATR Width Multiplier", minval=0.01, step=0.01)
pivotLen         = input.int(3, "5m Pivot Strength", minval=2, maxval=8)
cmfLen           = input.int(20, "CMF Length", minval=5)
obvLen           = input.int(30, "OBV Average Length", minval=5)
momLen           = input.int(12, "Momentum Length", minval=2)
adxLen           = input.int(14, "ADX Length", minval=5)
showZones        = input.bool(true, "Show Reversal Map Zones")

// ── Core indicators ───────────────────────────────────────────────────────────
vwapValue = ta.vwap(hlc3)
[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)
momValue = close - close[momLen]
obvValue = ta.cum(math.sign(ta.change(close)) * volume)
obvAvg   = ta.sma(obvValue, obvLen)
[diPlus, diMinus, adxValue] = ta.dmi(adxLen, adxLen)
rsiValue = ta.rsi(close, 14)
stochRaw = ta.stoch(rsiValue, rsiValue, rsiValue, 14)
stochK   = ta.sma(stochRaw, 3)
stochD   = ta.sma(stochK, 3)
atrValue = ta.atr(14)
volAvg   = ta.sma(volume, 20)
relVol   = na(volAvg) or volAvg == 0 ? 1.0 : volume / volAvg

// CMF: Money Flow Multiplier × Volume, normalised by total volume.
mfMultiplier = high == low ? 0.0 : ((close - low) - (high - close)) / (high - low)
mfVolume     = mfMultiplier * volume
cmfValue     = math.sum(mfVolume, cmfLen) / math.sum(volume, cmfLen)

// ── Time helpers ──────────────────────────────────────────────────────────────
nyHour = hour(time, tz)
nyMin  = minute(time, tz)
newDay = ta.change(time("D")) != 0

isPremarket = (nyHour > 4 or (nyHour == 4 and nyMin >= 0)) and (nyHour < 9 or (nyHour == 9 and nyMin < 30))
isOpenFirst15 = nyHour == 9 and nyMin >= 30 and nyMin < 45
isRegular = (nyHour > 9 or (nyHour == 9 and nyMin >= 30)) and (nyHour < 16)
afterMap90 = nyHour > 11 or (nyHour == 11 and nyMin >= 0)

// Trigger on 5m bar START; alert() is at bar close, so the delivery times are:
// 09:20→09:25, 09:40→09:45, 10:10→10:15, 10:55→11:00 ET.
mapPreopenBar = nyHour == 9 and nyMin == 20
map15Bar      = nyHour == 9 and nyMin == 40
map45Bar      = nyHour == 10 and nyMin == 10
map90Bar      = nyHour == 10 and nyMin == 55

// ── Daily map levels ──────────────────────────────────────────────────────────
var float preHigh = na
var float preLow = na
var float open15High = na
var float open15Low = na
var float lastPivotHigh = na
var float lastPivotLow = na
var bool zoneAlertSent = false

// Phase B keeps a short in-script queue because the 11:00 map and one possible
// zone confirmation can overlap.  Tracking alerts are sent to Neon only.
var trackActions = array.new_string()
var trackOpenTimes = array.new_int()
var trackCloseTimes = array.new_int()
var trackPrices = array.new_float()
var trackSupports = array.new_float()
var trackResistances = array.new_float()
var trackWidths = array.new_float()
var trackHighs = array.new_float()
var trackLows = array.new_float()
var trackPost5Sent = array.new_bool()
var trackPost10Sent = array.new_bool()
var trackPost15Sent = array.new_bool()

if newDay
    preHigh := na
    preLow := na
    open15High := na
    open15Low := na
    lastPivotHigh := na
    lastPivotLow := na
    zoneAlertSent := false
    array.clear(trackActions)
    array.clear(trackOpenTimes)
    array.clear(trackCloseTimes)
    array.clear(trackPrices)
    array.clear(trackSupports)
    array.clear(trackResistances)
    array.clear(trackWidths)
    array.clear(trackHighs)
    array.clear(trackLows)
    array.clear(trackPost5Sent)
    array.clear(trackPost10Sent)
    array.clear(trackPost15Sent)

if isPremarket
    preHigh := na(preHigh) ? high : math.max(preHigh, high)
    preLow := na(preLow) ? low : math.min(preLow, low)

if isOpenFirst15
    open15High := na(open15High) ? high : math.max(open15High, high)
    open15Low := na(open15Low) ? low : math.min(open15Low, low)

pivotHigh = ta.pivothigh(high, pivotLen, pivotLen)
pivotLow  = ta.pivotlow(low, pivotLen, pivotLen)
if not na(pivotHigh)
    lastPivotHigh := pivotHigh
if not na(pivotLow)
    lastPivotLow := pivotLow

prevDayHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
prevDayLow  = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_off)
zoneHalfWidth = math.min(maxHalfWidth, math.max(baseHalfWidth, atrValue * atrWidthFactor))

// Find the closest usable resistance above current price and support below it.
f_nearest_above(_price, _a, _b, _c, _d, _e) =>
    float best = na
    if not na(_a) and _a > _price
        best := _a
    if not na(_b) and _b > _price and (na(best) or _b < best)
        best := _b
    if not na(_c) and _c > _price and (na(best) or _c < best)
        best := _c
    if not na(_d) and _d > _price and (na(best) or _d < best)
        best := _d
    if not na(_e) and _e > _price and (na(best) or _e < best)
        best := _e
    best

f_nearest_below(_price, _a, _b, _c, _d, _e) =>
    float best = na
    if not na(_a) and _a < _price
        best := _a
    if not na(_b) and _b < _price and (na(best) or _b > best)
        best := _b
    if not na(_c) and _c < _price and (na(best) or _c > best)
        best := _c
    if not na(_d) and _d < _price and (na(best) or _d > best)
        best := _d
    if not na(_e) and _e < _price and (na(best) or _e > best)
        best := _e
    best

mapResistance = f_nearest_above(close, prevDayHigh, preHigh, open15High, lastPivotHigh, vwapValue)
mapSupport    = f_nearest_below(close, prevDayLow, preLow, open15Low, lastPivotLow, vwapValue)

// If no level sits on a side of price, use the closest reference to maintain a map.
mapResistance := na(mapResistance) ? (na(lastPivotHigh) ? preHigh : lastPivotHigh) : mapResistance
mapSupport := na(mapSupport) ? (na(lastPivotLow) ? preLow : lastPivotLow) : mapSupport

// ── 5m state: price action first, indicators confirm ──────────────────────────
bullStructure = close > vwapValue and close > open
bearStructure = close < vwapValue and close < open
bullLiquidity = obvValue > obvAvg and cmfValue > 0 and relVol >= 0.85
bearLiquidity = obvValue < obvAvg and cmfValue < 0 and relVol >= 0.85
bullMomentum = histLine > 0 and momValue > 0 and (adxValue < 20 or diPlus >= diMinus) and stochK >= stochD
bearMomentum = histLine < 0 and momValue < 0 and (adxValue < 20 or diMinus >= diPlus) and stochK <= stochD

bullScore = (bullStructure ? 1 : 0) + (bullLiquidity ? 1 : 0) + (bullMomentum ? 1 : 0)
bearScore = (bearStructure ? 1 : 0) + (bearLiquidity ? 1 : 0) + (bearMomentum ? 1 : 0)

nearSupport = not na(mapSupport) and math.abs(close - mapSupport) <= zoneHalfWidth
nearResistance = not na(mapResistance) and math.abs(close - mapResistance) <= zoneHalfWidth
callZoneConfirm = nearSupport and close > mapSupport and bullScore >= 2
putZoneConfirm  = nearResistance and close < mapResistance and bearScore >= 2

// ── JSON helpers ──────────────────────────────────────────────────────────────
f_jsonNum(_value) => na(_value) ? "null" : str.tostring(_value, "#.##")
f_bool(_value) => _value ? "true" : "false"

f_mapPayload(_action) =>
    '{"schema_version":"event-v2","symbol":"' + syminfo.ticker + '","timeframe":"5m","bar_open_time":' + str.tostring(time) + ',"bar_close_time":' + str.tostring(time_close) + ',"action":"' + _action + '","price":' + f_jsonNum(close) + ',"vwap":' + f_jsonNum(vwapValue) + ',"resistance":' + f_jsonNum(mapResistance) + ',"support":' + f_jsonNum(mapSupport) + ',"zone_half_width":' + f_jsonNum(zoneHalfWidth) + ',"cmf":' + f_jsonNum(cmfValue) + ',"obv_bull":' + f_bool(obvValue > obvAvg) + ',"relative_volume":' + f_jsonNum(relVol) + ',"hist":' + f_jsonNum(histLine) + ',"momentum":' + f_jsonNum(momValue) + ',"adx":' + f_jsonNum(adxValue) + ',"stoch_k":' + f_jsonNum(stochK) + ',"bull_score":' + str.tostring(bullScore) + ',"bear_score":' + str.tostring(bearScore) + ',"close_above_vwap":' + f_bool(close > vwapValue) + '}'

f_startTracking(_action) =>
    array.push(trackActions, _action)
    array.push(trackOpenTimes, time)
    array.push(trackCloseTimes, time_close)
    array.push(trackPrices, close)
    array.push(trackSupports, mapSupport)
    array.push(trackResistances, mapResistance)
    array.push(trackWidths, zoneHalfWidth)
    array.push(trackHighs, close)
    array.push(trackLows, close)
    array.push(trackPost5Sent, false)
    array.push(trackPost10Sent, false)
    array.push(trackPost15Sent, false)

f_trackingPayload(_index, _observationType) =>
    _parentAction = array.get(trackActions, _index)
    _parentOpen = array.get(trackOpenTimes, _index)
    _parentClose = array.get(trackCloseTimes, _index)
    _parentPrice = array.get(trackPrices, _index)
    _parentSupport = array.get(trackSupports, _index)
    _parentResistance = array.get(trackResistances, _index)
    _parentWidth = array.get(trackWidths, _index)
    _cumulativeHigh = array.get(trackHighs, _index)
    _cumulativeLow = array.get(trackLows, _index)
    '{"tracking_version":"tracking-v1","parent_schema_version":"event-v2","parent_symbol":"' + syminfo.ticker + '","parent_timeframe":"5m","parent_bar_open_time":' + str.tostring(_parentOpen) + ',"parent_bar_close_time":' + str.tostring(_parentClose) + ',"parent_action":"' + _parentAction + '","parent_support":' + f_jsonNum(_parentSupport) + ',"parent_resistance":' + f_jsonNum(_parentResistance) + ',"parent_range_low":null,"parent_range_high":null,"parent_zone_half_width":' + f_jsonNum(_parentWidth) + ',"observation_type":"' + _observationType + '","observed_bar_open_time":' + str.tostring(time) + ',"observed_bar_close_time":' + str.tostring(time_close) + ',"price_open":' + f_jsonNum(open) + ',"price_high":' + f_jsonNum(high) + ',"price_low":' + f_jsonNum(low) + ',"price_close":' + f_jsonNum(close) + ',"volume":' + f_jsonNum(volume) + ',"vwap":' + f_jsonNum(vwapValue) + ',"cmf":' + f_jsonNum(cmfValue) + ',"relative_volume":' + f_jsonNum(relVol) + ',"cumulative_high":' + f_jsonNum(_cumulativeHigh) + ',"cumulative_low":' + f_jsonNum(_cumulativeLow) + '}'

f_removeTracking(_index) =>
    array.remove(trackActions, _index)
    array.remove(trackOpenTimes, _index)
    array.remove(trackCloseTimes, _index)
    array.remove(trackPrices, _index)
    array.remove(trackSupports, _index)
    array.remove(trackResistances, _index)
    array.remove(trackWidths, _index)
    array.remove(trackHighs, _index)
    array.remove(trackLows, _index)
    array.remove(trackPost5Sent, _index)
    array.remove(trackPost10Sent, _index)
    array.remove(trackPost15Sent, _index)

f_emitEvent(_action) =>
    alert(f_mapPayload(_action), alert.freq_once_per_bar_close)
    f_startTracking(_action)

// ── Scheduled maps: only four per day ─────────────────────────────────────────
if barstate.isconfirmed and mapPreopenBar
    f_emitEvent("MAP_PREOPEN")

if barstate.isconfirmed and map15Bar
    f_emitEvent("MAP_OPEN_15")

if barstate.isconfirmed and map45Bar
    f_emitEvent("MAP_45")

if barstate.isconfirmed and map90Bar
    f_emitEvent("MAP_90")

// ── One decisive zone alert after the 90-minute map ────────────────────────────
if barstate.isconfirmed and isRegular and afterMap90 and not zoneAlertSent
    if callZoneConfirm
        zoneAlertSent := true
        f_emitEvent("ZONE_CALL_CONFIRM")
    else if putZoneConfirm
        zoneAlertSent := true
        f_emitEvent("ZONE_PUT_CONFIRM")

// ── Phase B: 5/10/15-minute silent observations after every V17 event ───────
if barstate.isconfirmed and array.size(trackActions) > 0
    for index = array.size(trackActions) - 1 to 0
        cumulativeHigh = math.max(array.get(trackHighs, index), high)
        cumulativeLow = math.min(array.get(trackLows, index), low)
        array.set(trackHighs, index, cumulativeHigh)
        array.set(trackLows, index, cumulativeLow)
        elapsedMs = time_close - array.get(trackCloseTimes, index)
        atRegularSessionClose = nyHour == 15 and nyMin == 55
        finalDueAt = array.get(trackCloseTimes, index) + 15 * 60 * 1000
        needsSessionCensor = time_close <= finalDueAt
        if atRegularSessionClose and needsSessionCensor
            alert(f_trackingPayload(index, "close_1600"), alert.freq_all)
            f_removeTracking(index)
        else if atRegularSessionClose
            // A completed horizon should already have been removed.  Never
            // continue an incomplete research tracker into after-hours.
            f_removeTracking(index)
        else if elapsedMs == 5 * 60 * 1000 and not array.get(trackPost5Sent, index)
            array.set(trackPost5Sent, index, true)
            alert(f_trackingPayload(index, "post_5m"), alert.freq_all)
        if elapsedMs == 10 * 60 * 1000 and not array.get(trackPost10Sent, index)
            array.set(trackPost10Sent, index, true)
            alert(f_trackingPayload(index, "post_10m"), alert.freq_all)
        if elapsedMs == 15 * 60 * 1000 and not array.get(trackPost15Sent, index)
            array.set(trackPost15Sent, index, true)
            alert(f_trackingPayload(index, "post_15m"), alert.freq_all)
            f_removeTracking(index)

// ── Visuals ───────────────────────────────────────────────────────────────────
resTop = mapResistance + zoneHalfWidth
resBottom = mapResistance - zoneHalfWidth
supTop = mapSupport + zoneHalfWidth
supBottom = mapSupport - zoneHalfWidth

pResTop = plot(showZones ? resTop : na, "Resistance Zone Top", color=color.new(color.red, 35), linewidth=1, style=plot.style_linebr)
pResBottom = plot(showZones ? resBottom : na, "Resistance Zone Bottom", color=color.new(color.red, 35), linewidth=1, style=plot.style_linebr)
pSupTop = plot(showZones ? supTop : na, "Support Zone Top", color=color.new(color.green, 35), linewidth=1, style=plot.style_linebr)
pSupBottom = plot(showZones ? supBottom : na, "Support Zone Bottom", color=color.new(color.green, 35), linewidth=1, style=plot.style_linebr)
fill(pResTop, pResBottom, color=color.new(color.red, 92), title="Resistance Area")
fill(pSupTop, pSupBottom, color=color.new(color.green, 92), title="Support Area")
plot(showZones ? vwapValue : na, "VWAP", color=color.orange, linewidth=2)

plotshape(showZones and callZoneConfirm and afterMap90 and not zoneAlertSent[1], title="CALL Zone Confirmation", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny, text="MAP")
plotshape(showZones and putZoneConfirm and afterMap90 and not zoneAlertSent[1], title="PUT Zone Confirmation", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny, text="MAP")

// Status label shown only on the final historical bar.
var label statusLabel = na
if barstate.islast and showZones
    label.delete(statusLabel)
    statusText = "TM Map V17 | 5m\nCMF: " + (cmfValue > 0 ? "سيولة داعمة" : cmfValue < 0 ? "سيولة سلبية" : "سيولة محايدة") + "\nMap only — no chase"
    statusLabel := label.new(bar_index, high, statusText, style=label.style_label_down, textcolor=color.white, color=color.new(color.black, 25), size=size.tiny)
